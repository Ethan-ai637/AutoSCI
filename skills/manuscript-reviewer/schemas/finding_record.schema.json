{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/manuscript-reviewer/finding_record.schema.json",
  "title": "Manuscript Reviewer Canonical Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id","disposition","primary_category","severity","confidence","salience","locations","claim_or_object","evidence_state","evidence_packet","observed_evidence","assessment","scientific_impact","remediation_class","recommended_fix","dependencies","summary_safe_statement","evidence_boundary"],
  "properties": {
    "record_id":{"type":"string","pattern":"^(CE|FT|NI|NT|CI|OC|XR|AQ|CG)-[0-9]{2,}$"},
    "disposition":{"enum":["finding","author_query","coverage_gap"]},
    "primary_category":{"enum":["CE","FT","NI","NT","CI","OC","XR"]},
    "severity":{"type":["string","null"],"enum":["Critical","Major","Moderate","Minor",null]},
    "confidence":{"enum":["High","Medium","Low"]},
    "salience":{"enum":["main_comment","secondary_finding","cleanup","query","coverage_gap"]},
    "locations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["surface","locator"],"properties":{"surface":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1}}}},
    "claim_or_object":{"type":"string","minLength":1},
    "evidence_state":{"enum":["verified_support","partial_support","contradicted","missing_required_evidence","ambiguous_mapping","unavailable_to_verify","not_applicable"]},
    "evidence_packet":{"type":"object","additionalProperties":false,"required":["anchors","protocol_comparability","provenance_status"],"properties":{
      "anchors":{"type":"array","items":{"type":"string"}},
      "protocol_comparability":{"enum":["established","uncertain","incompatible","not_applicable"]},
      "provenance_status":{"enum":["established","partial","unknown","not_applicable"]},
      "inference_bridge":{"enum":["direct","descriptive","comparative","statistical","causal","mechanistic","extrapolative","proxy_to_construct","deployment_or_utility","absence_or_equivalence","not_applicable"]},
      "source_values":{"type":"array","items":{"type":"string"}},
      "derivation":{"type":["string","null"]},
      "external_source_inspected":{"type":["boolean","null"]},
      "absence_check_complete":{"type":["boolean","null"]},
      "rendered_page_checked":{"type":["boolean","null"]},
      "surface_relation":{"type":["string","null"]}
    }},
    "observed_evidence":{"type":"string","minLength":1},
    "assessment":{"type":"string","minLength":1},
    "scientific_impact":{"type":["string","null"]},
    "remediation_class":{"type":["string","null"],"enum":["scope_qualification","text_reconciliation","label_or_crossref_repair","reporting_detail","notation_repair","citation_repair","reanalysis_or_recalculation","additional_analysis","additional_experiment","claim_removal",null]},
    "recommended_fix":{"type":"string","minLength":1},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "summary_safe_statement":{"type":"string","minLength":1},
    "evidence_boundary":{"type":["string","null"]},
    "review_context":{"enum":["initial_review","revision_check","rebuttal_check","version_delta"]},
    "revision_status":{"enum":["new","persistent","partially_resolved","reclassified"]},
    "prior_record_ids":{"type":"array","items":{"type":"string","pattern":"^(CE|FT|NI|NT|CI|OC|XR|AQ|CG)-[0-9]{2,}$"},"uniqueItems":true},
    "lineage_confidence":{"type":["string","null"],"enum":["High","Medium","Low",null]},
    "resolution_basis":{"type":["string","null"]}
  },
  "allOf":[
    {"if":{"properties":{"disposition":{"const":"finding"}}},"then":{"properties":{"record_id":{"type":"string","pattern":"^(CE|FT|NI|NT|CI|OC|XR)-[0-9]{2,}$"},"severity":{"enum":["Critical","Major","Moderate","Minor"]},"salience":{"enum":["main_comment","secondary_finding","cleanup"]},"scientific_impact":{"type":"string","minLength":1},"remediation_class":{"type":"string"}}}},
    {"if":{"properties":{"disposition":{"const":"author_query"}}},"then":{"properties":{"record_id":{"type":"string","pattern":"^AQ-[0-9]{2,}$"},"severity":{"const":null},"salience":{"const":"query"},"scientific_impact":{"type":["string","null"]},"remediation_class":{"const":null}}}},
    {"if":{"properties":{"disposition":{"const":"coverage_gap"}}},"then":{"properties":{"record_id":{"type":"string","pattern":"^CG-[0-9]{2,}$"},"severity":{"const":null},"salience":{"const":"coverage_gap"},"scientific_impact":{"type":["string","null"]},"remediation_class":{"const":null}}}}
  ]
}
