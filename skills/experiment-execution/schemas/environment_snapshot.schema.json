{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-attempt Execution Environment Snapshot",
  "type": "object",
  "required": ["schema_version", "run_id", "attempt_id", "platform", "hardware", "hardware_evidence", "software_versions"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "platform": {
      "type": "object",
      "required": ["operating_system", "architecture"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "hardware": {
      "type": "object",
      "required": ["cpu_model", "logical_cpu_count", "system_memory_bytes", "accelerators"],
      "properties": {
        "cpu_model": {"type": "string", "minLength": 1},
        "logical_cpu_count": {"type": "integer", "minimum": 1},
        "system_memory_bytes": {"type": "integer", "minimum": 1},
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "model", "device_count", "memory_bytes_per_device"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "device_count": {"type": "integer", "minimum": 1},
              "memory_bytes_per_device": {"type": ["integer", "null"], "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hardware_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "path", "sha256"],
        "properties": {
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "software_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "dependency_lock": {
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
